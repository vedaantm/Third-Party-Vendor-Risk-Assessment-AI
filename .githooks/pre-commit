#!/usr/bin/env bash
# Runs before each commit. Same tools and versions as CI (ci.yml):
#   - the lint ratchet (ruff, ruff format, mypy), when backend Python or its
#     lint config is staged;
#   - gitleaks over the staged changes, with a local binary or else the
#     pinned Docker image. Without either it warns and lets the commit
#     through, because CI scans the full history anyway.
# Enable with `make hooks`. The lint check reads the working tree, so with a
# partly staged file it checks your unstaged edits too.
set -uo pipefail

GITLEAKS_IMAGE="zricethezav/gitleaks@sha256:cdbb7c955abce02001a9f6c9f602fb195b7fadc1e812065883f695d1eeaba854"

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1
failed=0

if git diff --cached --name-only --diff-filter=ACMR -- \
    'backend/*.py' backend/pyproject.toml backend/lint-baseline.json | grep -q .; then
  echo "pre-commit: lint (ruff, ruff format, mypy)"
  (cd backend && uv run --locked python scripts/lint_baseline.py) || failed=1
fi

echo "pre-commit: gitleaks (staged changes)"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner . || failed=1
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  MSYS_NO_PATHCONV=1 docker run --rm -v "$root:/repo:ro" \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*' \
    "$GITLEAKS_IMAGE" git --staged --redact --no-banner /repo || failed=1
else
  echo "pre-commit: gitleaks skipped: install gitleaks or start Docker (CI still scans)" >&2
fi

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: commit blocked; fix the findings above" >&2
fi
exit "$failed"
