# backend/.env.example — copy to backend/.env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────
# Supabase PostgreSQL (asyncpg driver), e.g.
# postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres?ssl=require
DATABASE_URL=
GROQ_API_KEY=

# ── Optional ─────────────────────────────────────────────
# TLS to Postgres: "require" (default; Supabase) or "disable" (the local
# docker-compose Postgres, which docker-compose.yml sets for you)
DATABASE_SSL=require

# Redis cert cache; falls back to Supabase-only if unreachable.
# docker-compose overrides this to redis://redis:6379
REDIS_URL=redis://localhost:6379

# ChromaDB directory for RAG
CHROMA_PATH=./chroma_db

# Logging: LOG_LEVEL = DEBUG | INFO | WARNING | ERROR (default INFO);
# LOG_FORMAT = json (default, one JSON object per line) | console
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agents' scoring call: true = JSON-schema structured output (default),
# false = plain-text call parsed by regex (for eval comparisons)
AGENT_STRUCTURED_OUTPUT=true

# Comma-separated browser origins allowed to call the API.
# Default when unset: http://localhost:5173 (Vite dev server / docker frontend)
CORS_ALLOW_ORIGINS=http://localhost:5173

# ISO date/datetime; Supabase cert_cache rows cached before this are
# treated as expired. Set to the deploy date when cert discovery changes
# and the cache can't be purged. Unset = no cutoff.
CERT_CACHE_VALID_AFTER=

# CSA STAR live registry API (only used if DEMO_MODE is off)
CSA_STAR_API_KEY=

# ── Vendor document onboarding (ADR 0005) ────────────────
# Directory for uploaded vendor documents (local disk until MinIO, Phase 4)
DOCUMENT_STORAGE_DIR=./document_storage
# Largest accepted upload in bytes (default 26214400 = 25 MiB)
MAX_UPLOAD_BYTES=26214400
# Hours a vendor invite link stays valid (default 336 = 14 days)
INVITE_TTL_HOURS=336
# UUID of the single org every tenant row belongs to until Phase 1 auth
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
