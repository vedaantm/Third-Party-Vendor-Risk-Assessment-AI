# backend/.env.example — copy to backend/.env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────
# Supabase PostgreSQL (asyncpg driver), e.g.
# postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres?ssl=require
DATABASE_URL=
GROQ_API_KEY=

# ── Optional ─────────────────────────────────────────────
# Redis cert cache; falls back to Supabase-only if unreachable.
# docker-compose overrides this to redis://redis:6379
REDIS_URL=redis://localhost:6379

# ChromaDB directory for RAG
CHROMA_PATH=./chroma_db

# Comma-separated browser origins allowed to call the API.
# Default when unset: http://localhost:5173 (Vite dev server / docker frontend)
CORS_ALLOW_ORIGINS=http://localhost:5173

# ISO date/datetime; Supabase cert_cache rows cached before this are
# treated as expired. Set to the deploy date when cert discovery changes
# and the cache can't be purged. Unset = no cutoff.
CERT_CACHE_VALID_AFTER=

# CSA STAR live registry API (only used if DEMO_MODE is off)
CSA_STAR_API_KEY=
